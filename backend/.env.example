# Copy to backend/.env and fill in real values.
# Used when running the API natively (via run.sh / gunicorn), not through docker-compose.

# Point this at whatever Postgres the API should use — a native install,
# Synology's own Postgres, or the docker-compose "postgres" service exposed
# on the host (e.g. localhost:5432 or your NAS's LAN IP).
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/retirement-planner

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Comma-separated browser origins allowed to call the API. Only matters for
# cross-origin requests (e.g. `npm run dev` on :5173 hitting this API
# directly) — the production tunnel serves the frontend from this same
# process/origin, so CORS isn't even consulted there. Defaults to
# https://retirement.damsm.com,http://localhost:5173,http://localhost:6005
# CORS_ORIGINS=https://retirement.damsm.com,http://localhost:5173,http://localhost:6005
