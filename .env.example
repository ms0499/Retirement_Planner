# Copy this file to .env and fill in real values before deploying.

POSTGRES_USER=retirement
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retirement-planner

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# The URL your browser will use to reach the API. If your NAS is at
# 192.168.1.50, set this to http://192.168.1.50:8000
PUBLIC_API_URL=http://localhost:8000
