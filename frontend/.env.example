# Copy to frontend/.env.local — only needed when the frontend runs as a
# separate process/origin from the backend, e.g. `npm run dev` (:5173)
# talking to a locally-run backend (:6005).
#
# Leave this unset for a production build: the backend serves the built
# frontend itself on the same origin (see backend/app/main.py), which is
# what the retirement.damsm.com Cloudflare Tunnel points at, so requests
# are same-origin and no VITE_API_URL is needed.
VITE_API_URL=http://127.0.0.1:6005
